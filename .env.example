# Variables del servidor (Railway → Variables). Copia lo que necesites; ver DEPLOY-SERVIDOR.md.
DATA_DIR=/data                      # con un Volume montado en /data (imprescindible)
SESSION_SECRET=cambia-esto-por-una-cadena-larga-aleatoria
ADMIN_PASSWORD=                     # contraseña inicial del encargado (usuario «oficina»); vacía = genérica con cambio obligatorio
PROGRAMADOR_USUARIO=diego
PROGRAMADOR_PASSWORD=               # vacía = provisional 12345678 (cámbiala desde Cuenta)
# JEFE_USUARIO=admin              # cuenta del jefe (permisos de encargado, sin Actividad)
JEFE_PASSWORD=                     # vacía = genérica con cambio obligatorio
