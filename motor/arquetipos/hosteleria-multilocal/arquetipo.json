        "src/app/10-vista-hoy.js",
        "src/app/11-selector.js"
      ]
    },
    "semana": {
      "nucleo": true,
      "titulo": "Semana",
      "descripcion": "el cuadrante local × franja × día, editable, imprimible, exportable y compartible como imagen; «fijar como semana tipo»",
      "ficheros": [
        "src/app/13-vista-semana.js",
        "src/app/14-impresiones.js",
