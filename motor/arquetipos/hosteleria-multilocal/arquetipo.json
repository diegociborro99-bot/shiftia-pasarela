        "src/app/16-compartir.js"
      ]
    },
    "mes": {
      "nucleo": true,
      "titulo": "Mes",
      "descripcion": "personas × días con una píldora por día, ausencias, fila de control y eventos con refuerzo",
      "ficheros": [
        "src/app/17-vista-mes.js",
        "src/app/18-eventos.js",
        "src/app/23-revision.js"
      ]
    },
    "equipo": {
      "nucleo": true,
      "titulo": "Equipo",
      "descripcion": "fichas con todas las condiciones (activables), altas y bajas, reglas con interruptor y ajustes de cada local",
      "ficheros": [
        "src/app/19-vista-equipo.js",
        "src/app/20-ficha-persona.js"
      ]
    },
    "cobertura": {
      "nucleo": true,
      "titulo": "Cobertura",
      "descripcion": "quién cubre a quien falta: plan A y plan B día a día, confirmar con deshacer",
      "ficheros": [
        "src/app/26-cobertura.js"
      ]
    },
    "horas": {
      "defecto": true,
      "titulo": "Horas",
      "descripcion": "contador mensual por persona y local para la nómina, horas extra, cierre de mes, Excel e impresión",
      "ficheros": [
        "src/app/21-vista-horas.js"
      ]
    },
    "generador": {
      "defecto": true,
      "titulo": "Generador",
      "descripcion": "semana tipo + relleno inteligente con razones y huecos explicados; motor local o núcleo Shiftia (CP-SAT)",
      "ficheros": [
        "src/app/22-generador.js"
      ]
    },
    "actividad": {
      "defecto": true,
      "titulo": "Actividad",
